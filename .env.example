# ===========================================
# 智训云 · 本地环境变量模板
# ===========================================
# 1) 复制本文件到同目录下的 .env 文件：
#       Windows PowerShell:  Copy-Item .env.example .env
# 2) 把下方值替换为你自己的真实配置；.env 已被 .gitignore 屏蔽，不会被提交。
# ===========================================

# ---- 数据库 ----
# 本地 MySQL 示例：（如用 SQLite 做开发可填 sqlite:///./dev.db）
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/eval_system

# ---- JWT 登录 ----
# 生成一个随机长串，不要沿用示例
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# 单位：小时。默认 24，比赛演示可以拉长到 72 避免频繁登录
JWT_EXPIRE_HOURS=24

# ---- DeepSeek（AI 评价主通道）----
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 硅基流动（图片识别 / 备用通道）----
SILICON_API_KEY=sk-your-silicon-flow-key-here
SILICON_BASE_URL=https://api.siliconflow.cn/v1
